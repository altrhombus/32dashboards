{
  "name": "32dashboards",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "bundles:build": "turbo run build --filter=./bundles/*",
    "nodecg:setup": "node scripts/setup-nodecg-config.mjs",
    "nodecg:start": "nodecg start",
    "start": "pnpm bundles:build && nodecg start",
    "check-env": "bash scripts/check-env.sh",
    "kiosk-url": "bash scripts/kiosk-url.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "nodecg": "2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  }
}
