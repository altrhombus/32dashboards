{
  "name": "layout-kiosk",
  "version": "0.0.0",
  "private": true,
  "description": "Venue-TV graphics: renders each screen's chosen layout for the current scene, and keeps operator-saved layouts.",
  "scripts": {
    "build": "node ../../scripts/build-bundle.mjs",
    "dev": "node ../../scripts/build-bundle.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "bundleDependencies": {
      "fundraiser-core": "*"
    },
    "graphics": [
      {
        "file": "kiosk.html",
        "width": 1920,
        "height": 1080
      }
    ],
    "dashboardPanels": [
      {
        "name": "builder",
        "title": "Layouts",
        "fullbleed": true,
        "file": "builder.html"
      },
      {
        "name": "screens",
        "title": "Screens and layouts",
        "width": 5,
        "file": "screens.html"
      }
    ]
  },
  "dependencies": {
    "@32dashboards/incentive-machine": "workspace:*",
    "@32dashboards/layout-engine": "workspace:*",
    "@32dashboards/nodecg-react": "workspace:*",
    "@32dashboards/schema": "workspace:*",
    "@32dashboards/source-sdk": "workspace:*",
    "@32dashboards/ui": "workspace:*",
    "@xstate/react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "2.2.4",
    "xstate": "^5.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@32dashboards/config": "workspace:*",
    "@32dashboards/nodecg-testing": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "nodecg": "2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
